# ─── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─── Biến môi trường ────────────────────────────────────
.env
.env.local
*.env
!.env.example

# ─── Dữ liệu & mô hình (quá nặng để đưa lên Git) ────────
model/data/raw/**
model/data/processed/**
model/data/field/**
