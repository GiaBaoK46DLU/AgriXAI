model/checkpoints/**
!model/checkpoints/.gitkeep
model/outputs/**
!model/outputs/**/.gitkeep
*.pt
*.pth
*.onnx
runs/
wandb/

# ─── Ảnh người dùng tải lên ─────────────────────────────
backend/storage/uploads/**
backend/storage/overlays/**
!backend/storage/**/.gitkeep

# ─── Node / Web ─────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# ─── Flutter / Dart ─────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/android/
mobile/ios/
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/
*.iml

# ─── IDE / hệ điều hành ─────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ─── File tạm của Word ──────────────────────────────────
~$*.docx
