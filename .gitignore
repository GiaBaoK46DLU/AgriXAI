# ─── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─── Biến môi trường ────────────────────────────────────
.env
.env.local
*.env
!.env.example

# ─── Dữ liệu & mô hình (quá nặng để đưa lên Git) ────────
model/data/raw/**
model/data/processed/**
model/data/field/**
!model/data/**/.gitkeep
model/checkpoints/**
!model/checkpoints/.gitkeep
model/outputs/**
!model/outputs/**/
!model/outputs/**/.gitkeep
*.pt
*.pth
*.onnx
runs/
wandb/

# ─── Ảnh người dùng tải lên ─────────────────────────────
backend/storage/uploads/**
backend/storage/overlays/**
!backend/storage/**/.gitkeep

# ─── Node / Web ─────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# ─── Flutter / Dart ─────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/

# `android/` và `ios/` PHẢI theo Git. Quyền camera (#8) và
# `usesCleartextTraffic` (#9) nằm trong `AndroidManifest.xml`; ignore cả thư
# mục thì hai sửa đổi đó không bao giờ commit được — máy khác clone về chạy
# `flutter create` sẽ nhận manifest trắng, app không xin được quyền và không
# gọi nổi HTTP. Chỉ chặn phần công cụ sinh ra:
mobile/android/.gradle/
mobile/android/captures/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/**/GeneratedPluginRegistrant.java
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Flutter/App.framework/
mobile/ios/Flutter/Flutter.framework/
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/.last_build_id
mobile/ios/**/GeneratedPluginRegistrant.*
mobile/**/xcuserdata/
mobile/**/*.keystore
mobile/**/*.jks

# Đồ án không làm bản desktop/web — lỡ sinh ra thì bỏ qua.
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/
*.iml

# ─── IDE / hệ điều hành ─────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ─── File tạm của Word ──────────────────────────────────
~$*.docx
