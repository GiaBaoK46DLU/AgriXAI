# ─── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─── Docker cục bộ ──────────────────────────────────────
# Override port/cấu hình riêng cho máy đang xung đột cổng với container khác —
# không phải cấu hình chung của nhóm, đừng commit.
docker-compose.override.yml

# ─── Biến môi trường ────────────────────────────────────
.env
.env.local
*.env
!.env.example

# ─── Dữ liệu huấn luyện (quá nặng, tải lại được từ Kaggle — xem model/README.md) ────
model/data/raw/**
model/data/processed/**
model/data/field/**
!model/data/**/.gitkeep

# checkpoints/ và outputs/ ĐÃ THEO GIT từ 07/09/2026 (quyết định của Bảo) để máy
# khác pull về là chạy được model thật ngay, không phải huấn luyện lại ~30 phút.
# Không thêm lại *.pt/*.pth/*.onnx vào đây — sẽ chặn ngược checkpoint.
runs/
wandb/

# Phieu khoanh tay + ban doi chieu cua #17 (~70 MB, 56 anh x 2 ban).
# Sinh lai duoc bang mot lenh — xem docx/bao-cao-kiem-gradcam-vet-benh.md muc 7.
# MAT NA khoanh tay (khoanh-tay.json) va toan bo so lieu thi VAN theo Git,
# vi do moi la thu khong tai tao duoc bang may.
model/outputs/audit-gradcam-17/*/phieu/
model/outputs/audit-gradcam-17/*/doi-chieu/

# ─── Ảnh người dùng tải lên ─────────────────────────────
backend/storage/uploads/**
backend/storage/overlays/**
!backend/storage/**/.gitkeep

# ─── Node / Web ─────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# ─── Flutter / Dart ─────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/

# `android/` và `ios/` PHẢI theo Git. Quyền camera (#8) và
# `usesCleartextTraffic` (#9) nằm trong `AndroidManifest.xml`; ignore cả thư
# mục thì hai sửa đổi đó không bao giờ commit được — máy khác clone về chạy
# `flutter create` sẽ nhận manifest trắng, app không xin được quyền và không
# gọi nổi HTTP. Chỉ chặn phần công cụ sinh ra:
mobile/android/.gradle/
mobile/android/build/
mobile/android/captures/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/**/GeneratedPluginRegistrant.java
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Flutter/App.framework/
mobile/ios/Flutter/Flutter.framework/
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/.last_build_id
mobile/ios/**/GeneratedPluginRegistrant.*
mobile/**/xcuserdata/
mobile/**/*.keystore
mobile/**/*.jks

# Đồ án không làm bản desktop/web — lỡ sinh ra thì bỏ qua.
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/
*.iml

# ─── IDE / hệ điều hành ─────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ─── File tạm của Word ──────────────────────────────────
~$*.docx

# ─── Cấu hình MCP cục bộ (project_ref Supabase riêng máy) ──
.mcp.json
