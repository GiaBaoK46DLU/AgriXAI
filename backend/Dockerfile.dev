FROM python:3.13-slim

WORKDIR /app

# Cài đặt các system dependencies cần thiết cho psycopg2 và opencv
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Chúng ta sẽ mount code source vào /app qua volume trong docker-compose.
# Khởi chạy alembic (nếu cần), seed data và chạy server.
CMD sh -c "alembic upgrade head && python -m app.seed && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
