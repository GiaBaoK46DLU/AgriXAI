# Sao chép file này thành .env rồi chỉnh theo máy của bạn:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ─── Cơ sở dữ liệu ──────────────────────────────────────
# Khớp với docker-compose.yml ở thư mục gốc
DATABASE_URL=postgresql+psycopg2://plantdx:plantdx@localhost:5432/plantdx

# ─── Bảo mật ────────────────────────────────────────────
# Sinh khoá mới:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-khoa-nay-truoc-khi-trien-khai-that
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Mô hình ────────────────────────────────────────────
# Để TRỐNG thì backend dùng DummyPredictor (kết quả giả) — vẫn chạy được toàn
# bộ luồng để phát triển giao diện khi chưa huấn luyện xong.
# Có checkpoint rồi thì trỏ vào đây và cài thêm torch/torchvision.
MODEL_CHECKPOINT=
MODEL_PACKAGE_DIR=../model
MODEL_DEVICE=

# Bộ chặn 2 lớp lá cà chua / không phải lá (#92, nối vào backend ở #47). Chạy
# TRƯỚC mô hình bệnh, chỉ có tác dụng khi MODEL_CHECKPOINT ở trên cũng đã bật.
# Ảnh bị chặn trả disease_key="not_tomato_leaf" thay vì một tên bệnh. Để
# TRỐNG -> tắt hẳn, hành vi giống hệt trước #47 (mọi ảnh đều đi thẳng vào mô
# hình bệnh, kể cả ảnh không phải lá cà chua). Máy đã có checkpoint thật thì
# trỏ tới: ../model/checkpoints/organ_gate.pt
MODEL_GATE_CHECKPOINT=

# ─── Lưu trữ ảnh ────────────────────────────────────────
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
# Ảnh lớn hơn cạnh này sẽ được thu nhỏ trước khi lưu (giữ nguyên tỉ lệ)
MAX_IMAGE_DIMENSION=1280

# ─── XAI ────────────────────────────────────────────────
# Ngưỡng cắt bản đồ nhiệt để tạo vùng khoanh (0..1). Cao hơn = vùng nhỏ và
# chắc chắn hơn; thấp hơn = vùng rộng, dễ bao trùm cả chỗ không liên quan.
HEATMAP_THRESHOLD=0.5

# ─── Thời tiết ──────────────────────────────────────────
# Key OpenWeather (https://openweathermap.org/api) dùng cho ô thời tiết ở
# trang chủ app di động. Để trống thì GET /weather trả lỗi 503 rõ ràng thay vì
# gọi API bằng key rỗng.
OPENWEATHER_API_KEY=

# ─── CORS ───────────────────────────────────────────────
# web-admin (Next.js, từ 16/09/2026) KHÔNG cần origin ở đây nữa — kiến trúc
# BFF nghĩa là mọi lệnh gọi backend chạy phía server của Next.js, không phải
# trình duyệt (xem web-admin/README.md mục "Kiến trúc: BFF"). Để trống trừ
# khi tự gọi backend thẳng từ trình duyệt lúc debug.
CORS_ORIGINS=

# ─── Khác ───────────────────────────────────────────────
PROJECT_NAME=Chẩn đoán bệnh cây trồng
API_V1_PREFIX=/api/v1
DEBUG=true
